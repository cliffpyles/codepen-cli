{
  "name": "codepen-cli",
  "version": "2.0.0",
  "description": "Command-line interface for the CodePen API v2: manage Pens, files, Collections, and Assets from your terminal.",
  "keywords": [
    "cli",
    "codepen",
    "pens",
    "api"
  ],
  "author": "Cliff Pyles <cliff@cliffpyles.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cliffpyles/codepen-cli.git"
  },
  "homepage": "https://github.com/cliffpyles/codepen-cli#readme",
  "bugs": {
    "url": "https://github.com/cliffpyles/codepen-cli/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "codepen": "dist/cli.js",
    "codepen-cli": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage",
    "prepublishOnly": "npm run clean && npm run check && npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.5"
  }
}
